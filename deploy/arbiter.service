# systemd *user* unit for arbiter.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/arbiter.service ~/.config/systemd/user/
#   $EDITOR ~/.config/systemd/user/arbiter.service     # set WorkingDirectory
#   systemctl --user daemon-reload
#   systemctl --user enable --now arbiter
#
# A user unit stops when your last session ends unless lingering is enabled for the account:
#
#   loginctl enable-linger $USER
#
# That needs privileges you may not have on a shared box. Without it, start the server the way
# ./run.sh serve does -- detached under setsid, with a pid file -- and leave this unit unused.

[Unit]
Description=arbiter, a Jev-compatible System One server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/recipes/arbiter
ExecStart=%h/recipes/arbiter/run.sh serve-foreground
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

Environment=PORT=8010
Environment=HOST=0.0.0.0
Environment=ARBITER_DEVICE=cuda
Environment=ARBITER_MODE=eager
Environment=ARBITER_DTYPE=autocast
Environment=ARBITER_MODELS=english,multilingual,typed-decisions
# Environment=ARBITER_API_KEY=

[Install]
WantedBy=default.target
